# BF_Anti RATE mode - Betaflight 4.5.3 / S405 OMNIBUSF4SD
# Apply in Betaflight Configurator CLI, then: save
# Companion: profile real_pn8_rate, control.att_mode=rate,
#            rate_full_dps=600, yaw_full_rate_dps=300.
#
# BF has no RATE flight mode. ACRO = ANGLE and HORIZON both off.
# These values are per active rate profile (normally rateprofile 0).

# 1) ACRO + MSP OVERRIDE: slot 1 replaces the old ANGLE range on this FC;
#    MSP OVERRIDE is AUX4 (CH8) 1300-2100. There is no RATE flight mode.
#    WARNING: this rewrites only slot 1.  Before applying, dump the live aux
#    table (`aux` in CLI, or scripts/fc_identify.py) and confirm ARM is on
#    CH5 1700-2100.  Do not blindly add an ARM range for a different switch.
aux 1 50 3 1300 2100 0 0

# 2) ACTUAL rates: center == max => linear 600/600/300 deg/s
#    Explicitly select rateprofile 0: the active profile index is persisted,
#    so without this line the CLI may tune a profile that is not in use.
#    CLI stores 1/10: 60 -> 600 dps, 30 -> 300 dps
rateprofile 0
set rates_type = ACTUAL
set roll_rc_rate = 60
set pitch_rc_rate = 60
set yaw_rc_rate = 30
set roll_srate = 60
set pitch_srate = 60
set yaw_srate = 30
set roll_expo = 0
set pitch_expo = 0
set yaw_expo = 0

# 3) Explicit channel map, zero deadband & low-latency RC smoothing
map AETR1234
set deadband = 0
set yaw_deadband = 0
set angle_limit = 60
set rc_smoothing = ON
set rc_smoothing_auto_factor = 15

# 4) MSP override: RPYT from companion, AUX stays on CRSF.
#    BF 4.5.x has no companion-frame freshness timeout.  If the Pi dies while
#    CH8 remains high and CRSF is still alive, the FC holds the last RPYT
#    frame; the pilot must flip CH8 LOW immediately.  RestartSec=2 brings the
#    service back, but it cannot un-freeze a crashed airframe.
set msp_override_channels_mask = 15
set msp_override_failsafe = OFF

# 4) Failsafe
set failsafe_procedure = DROP
set failsafe_delay = 10
set failsafe_off_delay = 10
set failsafe_throttle = 1000

save
