<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="inspect_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="inspect_cam_front">
      <static>true</static>
      <pose>0.8 -0.8 0.55 0 0.28 2.356</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on><update_rate>10</update_rate>
          <camera><horizontal_fov>1.2</horizontal_fov><image><width>800</width><height>600</height><format>R8G8B8</format></image><clip><near>0.02</near><far>100</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="inspect_cam_bottom">
      <static>true</static>
      <pose>0.7 -0.7 -0.35 0 -0.75 2.356</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on><update_rate>10</update_rate>
          <camera><horizontal_fov>1.2</horizontal_fov><image><width>800</width><height>600</height><format>R8G8B8</format></image><clip><near>0.02</near><far>100</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="inspect_cam_nose">
      <static>true</static>
      <pose>0.30 -0.30 0.50 0 0.38 2.356</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on><update_rate>10</update_rate>
          <camera><horizontal_fov>1.0</horizontal_fov><image><width>800</width><height>600</height><format>R8G8B8</format></image><clip><near>0.02</near><far>100</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="inspect_cam_close">
      <static>true</static>
      <pose>0.12 -0.12 0.30 0 0.35 2.356</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on><update_rate>10</update_rate>
          <camera><horizontal_fov>1.0</horizontal_fov><image><width>800</width><height>600</height><format>R8G8B8</format></image><clip><near>0.02</near><far>100</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="inspect_cam_model">
      <static>true</static>
      <pose>0.45 -0.45 0.40 0 0.44 2.356</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on><update_rate>10</update_rate>
          <camera><horizontal_fov>1.0</horizontal_fov><image><width>800</width><height>600</height><format>R8G8B8</format></image><clip><near>0.02</near><far>100</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="inspect_cam_nose_side">
      <static>true</static>
      <pose>0.45 0.0 0.48 0 0.11 3.141593</pose>
      <link name="link">
        <sensor name="cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <always_on>1</always_on><update_rate>10</update_rate>
          <camera><horizontal_fov>1.0</horizontal_fov><image><width>800</width><height>600</height><format>R8G8B8</format></image><clip><near>0.02</near><far>100</far></clip></camera>
        </sensor>
      </link>
    </model>
    <model name="shell_static">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <include>
        <uri>model://bf_anti_shell</uri>
        <pose>0 0 0 0 0 0</pose>
        <static>true</static>
      </include>
    </model>
  </world>
</sdf>
