[Unit]
# BF_Anti onboard runtime on the Raspberry Pi 5.
# The install script renders __INSTALL_DIR__ and __BOARD_USER__:
#   sudo bash scripts/pi5_install.sh
Description=BF_Anti onboard runtime (camera, OSD, FB, FC link)
Documentation=file://__INSTALL_DIR__/README.md
# Runtime logs:
#   journalctl -u bf-anti-onboard -b          (volatile unless persistent)
#   __INSTALL_DIR__/logs/run_*/telemetry.csv  (blackbox, always on disk)
# Run scripts/pi5_log_check.sh after boot to verify both.
After=local-fs.target
# Do NOT order on dev-fb0.device: systemd can create a device job that never
# activates for the framebuffer, which blocks the service indefinitely.  The
# runtime opens fb0/video/FC lazily and retries internally, so no device
# ordering is required.
# A crash loop should eventually stop, but 5/60 s also killed the unit
# after a few early power/FC transients.  The app already retries component
# startup internally; this is only a last-resort guard.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
# Board account; must be in the video group for /dev/fb0 and /dev/video*.
User=__BOARD_USER__
SupplementaryGroups=video dialout
# Keep the flight runtime alive if the OOM killer fires during a Hailo/OpenCV
# allocation spike.
OOMScoreAdjust=-500
WorkingDirectory=__INSTALL_DIR__
# Optional overrides: BF_ANTI_HOME / BF_ANTI_VENV / BF_ANTI_CONFIG.
EnvironmentFile=-/etc/bf-anti/onboard.env
Environment=PYTHONUNBUFFERED=1
# There is no X11 on the aircraft; never let OpenCV try a GUI backend.
Environment=DISPLAY=
Environment=OPENCV_VIDEOIO_PRIORITY_V4L2=1
# One identifier for journald and the blackbox run directory.
SyslogIdentifier=bf-anti-onboard
StandardOutput=journal
StandardError=journal
# The wrapper resolves BF_ANTI_CONFIG (EnvironmentFile) or the default
# config path.  Do not append a second --config here: argparse would silently
# override the environment with the install-path default.
ExecStart=__INSTALL_DIR__/scripts/pi5_run_onboard.sh

# Restart only on failure. A clean SIGTERM stop (pilot disarm / maintenance)
# must stay stopped instead of coming back up on its own.
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=20
KillSignal=SIGTERM

# Light hardening; the runtime still needs /dev/fb0, /dev/hailo0,
# /dev/video* and /dev/ttyACM0, so devices and /home stay accessible.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
# The runtime writes logs/run_* under the install dir.  If log_dir is moved
# outside /home or /var, add it here or the blackbox will report EROFS.
ReadWritePaths=__INSTALL_DIR__
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
