{
  "profile": "real_pn8_rate",
  "log_dir": "logs",
  "telemetry": {
    "enabled": true,
    "hz": 10,
    "max_file_mb": 32,
    "max_runs": 20,
    "flush_interval_s": 1,
    "fsync_interval_s": 5,
    "level": "INFO",
    "max_segments": 20
  },
  "fc": {
    "port": "/dev/ttyACM0",
    "baud": 115200,
    "tcp_host": "",
    "tcp_port": 5761,
    "telemetry_hz": 50,
    "rc_hz": 50,
    "reply_timeout_s": 0.15,
    "link_timeout_s": 0.6,
    "aux_arm": 4,
    "aux_angle": 5,
    "aux_override": 7,
    "aux_engage": 7,
    "require_override": true,
    "require_engage": true,
    "override_from_mode": true,
    "stick_takeover": false,
    "enable_aux_discovery": true,
    "aux_meta_timeout_s": 0.08,
    "enable_msp2_position": false
  },
  "power": {
    "aux_channel": 6,
    "hold_s": 2.0,
    "require_disarmed": true,
    "max_throttle": 1100,
    "max_rc_age_s": 0.3,
    "max_status_age_s": 0.6,
    "high_threshold": 1700,
    "min_low_threshold": 885,
    "low_threshold": 1300
  },
  "camera": {
    "device": "/dev/video0",
    "width": 1280,
    "height": 720,
    "fps": 30,
    "fourcc": "MJPG",
    "rotate_deg": 0,
    "hfov_deg": 70,
    "vfov_deg": null,
    "tilt_deg": 40,
    "yaw_offset_deg": 0,
    "dist_coeffs": null,
    "latency_s": 0.0,
    "warmup_s": 1,
    "strict_size": true,
    "autofocus": null,
    "auto_exposure": null,
    "exposure": null,
    "gain": null,
    "auto_wb": null,
    "wb_temp": null
  },
  "detector": {
    "backend": "hailo",
    "hef": "model/yolov8n_drone_h8l.hef",
    "input_width": 640,
    "input_height": 640,
    "conf_threshold": 0.25,
    "iou_threshold": 0.45,
    "max_detections": 10,
    "class_names": [
      "drone"
    ],
    "async_infer": true,
    "confirm_frames": 2,
    "max_coast_frames": 6,
    "gate_px": 90,
    "gate_gain": 3,
    "replay_path": "",
    "replay_loop": true,
    "max_coast_s": 0.25,
    "gate_frac": 0.15,
    "coast_vel_tau_s": 0.24,
    "infer_timeout_ms": 1000
  },
  "guidance": {
    "params": {}
  },
  "safety": {
    "max_rc_age_s": 0.3,
    "max_att_age_s": 0.25,
    "max_alt_age_s": 0.35,
    "max_status_age_s": 0.6,
    "max_loop_dt_s": 0.1,
    "max_det_age_s": 0.4,
    "min_altitude_m": 2,
    "max_altitude_m": 60,
    "max_range_m": 80,
    "min_battery_v": 20.4,
    "target_confirm_s": 0.1,
    "target_lost_s": 0.4,
    "lost_reset_s": 1.5,
    "fault_latch": true,
    "battery_debounce_s": 1.0,
    "max_analog_age_s": 2.0,
    "terminal_coast_s": 0.9
  },
  "video": {
    "enabled": true,
    "fb": "/dev/fb0",
    "width": 720,
    "height": 576,
    "fps": 25,
    "osd": true,
    "letterbox": true,
    "font_path": "",
    "draw_box": true
  },
  "control": {
    "rate_hz": 50,
    "att_mode": "rate",
    "att_rate_gain": 6,
    "rate_max_dps": 250,
    "rate_full_dps": 600,
    "angle_limit_deg": 60,
    "yaw_full_rate_dps": 300,
    "rc_rate_limit": 60,
    "roll_sign": 1,
    "pitch_sign": 1,
    "yaw_sign": 1,
    "throttle_min": 1000,
    "throttle_max": 2000,
    "hover_throttle": 1430,
    "rc_slew_rate_per_s": 1200.0
  }
}
