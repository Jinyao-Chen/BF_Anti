# BF_Anti RATE mode - Betaflight 4.5.3 / S405 OMNIBUSF4SD
# Apply in Betaflight Configurator CLI, then: save
# Companion: profile real_pn8_rate, control.att_mode=rate,
#            rate_full_dps=600, yaw_full_rate_dps=300.
#
# BF has no RATE flight mode. ACRO = ANGLE and HORIZON both off.
# These values are per active rate profile (normally rateprofile 0).

# 1) ACRO + MSP OVERRIDE: slot 1 replaces the old ANGLE range on this FC;
#    MSP OVERRIDE is AUX4 (CH8) 1300-2100. There is no RATE flight mode.
aux 1 50 3 1300 2100 0 0

# 2) ACTUAL rates: center == max => linear 600/600/300 deg/s
#    CLI stores 1/10: 60 -> 600 dps, 30 -> 300 dps
set rates_type = ACTUAL
set roll_rc_rate = 60
set pitch_rc_rate = 60
set yaw_rc_rate = 30
set roll_srate = 60
set pitch_srate = 60
set yaw_srate = 30
set roll_expo = 0
set pitch_expo = 0
set yaw_expo = 0

# 3) MSP override: RPYT from companion, AUX stays on CRSF
set msp_override_channels_mask = 15
set msp_override_failsafe = OFF

# 4) Failsafe
set failsafe_procedure = DROP
set failsafe_delay = 10
set failsafe_off_delay = 10
set failsafe_throttle = 1000

save
